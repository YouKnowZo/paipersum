{
  "manifest_version": 3,
  "name": "PaiperSum Legal Simplifier",
  "version": "0.1.0",
  "description": "Summarize legal agreements with color‑coded risk.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": { "default_title": "PaiperSum" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end" }
  ]
}