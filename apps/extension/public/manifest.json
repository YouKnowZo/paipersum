{
  "manifest_version": 3,
  "name": "PaiperSum Legal Simplifier",
  "version": "0.1.0",
  "description": "Summarize legal agreements with color-coded risk analysis. Instantly analyze Terms of Service, privacy policies, and contracts.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Analyze this page with PaiperSum",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
