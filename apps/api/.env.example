# PaiperSum API Backend Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Server port (default: 8000)
PORT=8000

# Environment (development, staging, production)
ENVIRONMENT=development

# CORS Origins (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://paipersum.com

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# For production, use PostgreSQL or MongoDB

# PostgreSQL (recommended for production)
DATABASE_URL=postgresql://user:password@localhost:5432/paipersum

# MongoDB (alternative)
MONGODB_URI=mongodb://localhost:27017/paipersum

# Redis (for rate limiting and caching)
REDIS_URL=redis://localhost:6379

# =============================================================================
# AUTH0 CONFIGURATION (Required for OAuth)
# =============================================================================
# Get these from https://auth0.com
# 
# Setup Steps:
# 1. Create an Auth0 account
# 2. Create a new API in the Auth0 dashboard
# 3. Create a Machine-to-Machine Application
# 4. Get the credentials below

AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your_client_id
AUTH0_CLIENT_SECRET=your_client_secret
AUTH0_AUDIENCE=https://api.paipersum.com

# =============================================================================
# STRIPE CONFIGURATION (for payments)
# =============================================================================
# Get these from https://stripe.com

STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
STRIPE_PRICE_ID=price_xxxxx

# =============================================================================
# AI/ML CONFIGURATION
# =============================================================================

# OpenAI (optional - for enhanced analysis)
OPENAI_API_KEY=

# Hugging Face (for local models)
HF_TOKEN=

# =============================================================================
# MONITORING & LOGGING
# =============================================================================

# Sentry DSN for error tracking
SENTRY_DSN=

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# =============================================================================
# SECURITY
# =============================================================================

# JWT Secret (generate with: openssl rand -hex 32)
JWT_SECRET=your-super-secret-jwt-key-at-least-32-chars

# API Rate Limiting (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=60
