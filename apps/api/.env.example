# PaiperSum API Environment Variables

# Security
ADMIN_TOKEN=admin_secure_token_change_in_production
JWT_SECRET=change_this_secret_key_in_production

# CORS
ALLOWED_ORIGINS=*

# Stripe (optional, for payments)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Monitoring (optional)
SENTRY_DSN=

# Database (optional, if implementing persistence)
DATABASE_URL=postgresql://user:pass@localhost:5432/paipersum

# Redis (optional, for caching)
REDIS_URL=redis://localhost:6379
