# Backend Environment Variables
# Copy this to .env and fill in your values

# CORS (Allow these domains to access API)
ALLOWED_ORIGINS=https://paipersum.com,https://www.paipersum.com,http://localhost:5173

# Admin portal shared secret (required for /admin/* endpoints)
ADMIN_API_KEY=replace-with-strong-passphrase

# Supabase (Database & Auth - get from https://supabase.com)
# Optional: Only if using Supabase
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Stripe (Payments - get from https://stripe.com)
# Optional: Only when accepting payments
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Resend (Email - get from https://resend.com)
# Optional: Only for sending emails
RESEND_API_KEY=re_xxxxx

# Sentry (Error Tracking - get from https://sentry.io)
# Optional: Only for production monitoring
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
