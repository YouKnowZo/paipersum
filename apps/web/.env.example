# PaiperSum Web Frontend Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED - API Configuration
# =============================================================================

# Backend API URL (your FastAPI server)
# Local development: http://localhost:8000
# Production: https://api.paipersum.com
VITE_API_URL=http://localhost:8000

# =============================================================================
# OPTIONAL - Auth0 Configuration (for OAuth login)
# =============================================================================
# Get these from https://auth0.com (free tier available)
# 
# Setup Steps:
# 1. Create an Auth0 account at https://auth0.com
# 2. Create a new Application (Single Page Web Application)
# 3. Add your domains to "Allowed Callback URLs":
#    - http://localhost:5173 (development)
#    - https://paipersum.com (production)
# 4. Add your domains to "Allowed Logout URLs":
#    - http://localhost:5173 (development)
#    - https://paipersum.com (production)
# 5. Add your domains to "Allowed Web Origins":
#    - http://localhost:5173 (development)
#    - https://paipersum.com (production)
# 6. Copy the Domain and Client ID below

VITE_AUTH0_DOMAIN=your-tenant.auth0.com
VITE_AUTH0_CLIENT_ID=your_client_id_here

# =============================================================================
# OPTIONAL - Stripe Configuration (for payments)
# =============================================================================
# Get these from https://stripe.com
# Use test keys for development (pk_test_xxx)

VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx

# =============================================================================
# OPTIONAL - Analytics & Monitoring
# =============================================================================

# Sentry for error tracking (https://sentry.io)
VITE_SENTRY_DSN=

# Google Analytics
VITE_GA_MEASUREMENT_ID=
