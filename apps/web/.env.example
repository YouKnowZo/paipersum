# Environment Variables for PaiperSum

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/paipersum

# Auth
AUTH_SECRET=generate-a-random-32-character-string-here-use-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# Email (for Auth.js email provider)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@paipersum.com
SMTP_PASSWORD=your-password

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_ANNUAL_PRICE_ID=price_...

# Analysis API (FastAPI service)
ANALYSIS_API_URL=http://localhost:8000

# Analytics (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# File Storage (optional - for Vercel Blob)
BLOB_READ_WRITE_TOKEN=

# Environment
NODE_ENV=development
