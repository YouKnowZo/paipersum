# Frontend Environment Variables
# Copy this to .env and fill in your values

# API URL (your backend)
VITE_API_URL=https://api.paipersum.com

# Supabase (Authentication - get from https://supabase.com)
# Optional: Only needed if you upgrade from localStorage auth
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Auth0 (Authentication - https://auth0.com)
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=xxxxxxxxxxxxxxxxxxxx
VITE_AUTH0_AUDIENCE=https://api.paipersum.com

# Stripe (Payments - get from https://stripe.com)
# Optional: Only needed when you want to accept payments
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx

# Sentry (Error Tracking - get from https://sentry.io)
# Optional: Only for production error monitoring
VITE_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
