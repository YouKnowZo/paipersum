# PaiperSum Environment Variables
# Copy this to .env and fill in your values

# ============================================
# Frontend Environment Variables (apps/web)
# ============================================

# API Configuration
VITE_API_URL=http://localhost:8000

# Auth0 (Authentication)
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your_auth0_client_id
VITE_AUTH0_AUDIENCE=https://api.paipersum.com

# Stripe (Payments)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
VITE_STRIPE_PRICE_MONTHLY=price_monthly_id
VITE_STRIPE_PRICE_YEARLY=price_yearly_id

# Analytics (Optional)
VITE_GA_TRACKING_ID=G-XXXXXXXXXX
VITE_POSTHOG_KEY=phc_xxxxxxxxxxxxx
VITE_POSTHOG_HOST=https://app.posthog.com

# Error Tracking (Optional)
VITE_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# ============================================
# Backend Environment Variables (apps/api)
# ============================================

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/paipersum

# Auth0
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.paipersum.com
AUTH0_ALGORITHMS=["RS256"]

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_MONTHLY=price_monthly_id
STRIPE_PRICE_YEARLY=price_yearly_id

# Application URLs
STRIPE_SUCCESS_URL=https://paipersum.com/success
STRIPE_CANCEL_URL=https://paipersum.com/pricing
FRONTEND_URL=https://paipersum.com

# Redis (Optional - for caching)
REDIS_URL=redis://localhost:6379

# S3/MinIO (Optional - for file storage)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=paipersum

# Email (Optional - for notifications)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_sendgrid_api_key
SMTP_FROM=noreply@paipersum.com

# Monitoring
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
LOG_LEVEL=INFO

# Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
ALLOWED_ORIGINS=http://localhost:5173,https://paipersum.com

# ============================================
# Development vs Production
# ============================================

# Development: Use localhost URLs and test keys
# Production: Use production URLs and live keys

# For production, set:
# - DATABASE_URL: Production database (Railway, Supabase, etc.)
# - All keys to live/production versions
# - ALLOWED_ORIGINS: Your production domain(s)
# - LOG_LEVEL: WARNING or ERROR

# ============================================
# Quick Setup Commands
# ============================================

# 1. Copy this file:
#    cp .env.example .env

# 2. Fill in the values above

# 3. For Auth0:
#    See AUTH0_SETUP_GUIDE.md

# 4. For Database:
#    See DATABASE_SETUP_GUIDE.md

# 5. For Stripe:
#    See STRIPE_SETUP_GUIDE.md
