{
  "name": "paipersum",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:ext": "npm --workspace apps/extension run dev",
    "build": "npm -w apps/web run build && npm -w apps/extension run build",
    "lint": "eslint \"**/*.{ts,tsx,js}\" --max-warnings=0",
    "a11y": "playwright test && axe --exit zero apps/web/dist",
    "test": "npm --workspace apps/web run test && npm --workspace apps/api run test",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "migrate": "cd apps/api && alembic upgrade head",
    "seed": "cd apps/api && python seed_data.py"
  },
  "devDependencies": {
    "eslint": "^9.12.0",
    "eslint-config-standard-with-typescript": "^43.0.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-n": "^17.10.3",
    "eslint-plugin-promise": "^6.2.0",
    "@playwright/test": "^1.40.0",
    "axe-core": "^4.8.0"
  }
}