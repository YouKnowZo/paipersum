{
  "$schema": "https://tr.designtokens.org/format/v1.0.0/schema.json",
  "color": {
    "brand": {
      "blue": {
        "$type": "color",
        "$value": "#0f4c81",
        "$description": "Primary brand color for CTAs and key actions"
      },
      "green": {
        "$type": "color",
        "$value": "#2e7d32",
        "$description": "Low risk indicator, success states"
      },
      "yellow": {
        "$type": "color",
        "$value": "#f9a825",
        "$description": "Moderate risk indicator, warning states"
      },
      "red": {
        "$type": "color",
        "$value": "#c62828",
        "$description": "High risk indicator, destructive actions"
      }
    },
    "ink": {
      "900": {
        "$type": "color",
        "$value": "#0b1324",
        "$description": "Primary text, headings"
      },
      "700": {
        "$type": "color",
        "$value": "#1f2937",
        "$description": "Body text"
      },
      "500": {
        "$type": "color",
        "$value": "#4b5563",
        "$description": "Secondary text"
      },
      "300": {
        "$type": "color",
        "$value": "#9ca3af",
        "$description": "Tertiary text, placeholders"
      }
    },
    "paper": {
      "0": {
        "$type": "color",
        "$value": "#ffffff",
        "$description": "Pure white, cards, modals"
      },
      "50": {
        "$type": "color",
        "$value": "#f9fafb",
        "$description": "Background, subtle contrast"
      },
      "100": {
        "$type": "color",
        "$value": "#f3f4f6",
        "$description": "Hover states, dividers"
      }
    },
    "border": {
      "200": {
        "$type": "color",
        "$value": "#e5e7eb",
        "$description": "Default borders, dividers"
      }
    }
  },
  "typography": {
    "font-family": {
      "ui": {
        "$type": "fontFamily",
        "$value": "Inter",
        "$description": "Primary UI font"
      },
      "legal": {
        "$type": "fontFamily",
        "$value": "Source Serif Pro",
        "$description": "Legal document text"
      }
    },
    "font-weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    },
    "font-size": {
      "xs": { "$type": "dimension", "$value": "12px" },
      "sm": { "$type": "dimension", "$value": "14px" },
      "base": { "$type": "dimension", "$value": "16px" },
      "lg": { "$type": "dimension", "$value": "18px" },
      "xl": { "$type": "dimension", "$value": "20px" },
      "2xl": { "$type": "dimension", "$value": "24px" },
      "3xl": { "$type": "dimension", "$value": "30px" }
    },
    "line-height": {
      "tight": { "$type": "number", "$value": 1.25 },
      "base": { "$type": "number", "$value": 1.5 },
      "relaxed": { "$type": "number", "$value": 1.75 }
    }
  },
  "radius": {
    "xs": { "$type": "dimension", "$value": "6px" },
    "sm": { "$type": "dimension", "$value": "10px" },
    "md": { "$type": "dimension", "$value": "12px" },
    "lg": { "$type": "dimension", "$value": "16px" },
    "xl": { "$type": "dimension", "$value": "24px" },
    "full": { "$type": "dimension", "$value": "9999px" }
  },
  "spacing": {
    "xs": { "$type": "dimension", "$value": "4px" },
    "sm": { "$type": "dimension", "$value": "8px" },
    "md": { "$type": "dimension", "$value": "12px" },
    "lg": { "$type": "dimension", "$value": "16px" },
    "xl": { "$type": "dimension", "$value": "24px" },
    "2xl": { "$type": "dimension", "$value": "32px" },
    "3xl": { "$type": "dimension", "$value": "48px" },
    "4xl": { "$type": "dimension", "$value": "64px" }
  },
  "shadow": {
    "sm": {
      "$type": "shadow",
      "$value": {
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0px",
        "color": "rgba(0, 0, 0, 0.06)"
      }
    },
    "md": {
      "$type": "shadow",
      "$value": {
        "offsetX": "0px",
        "offsetY": "6px",
        "blur": "18px",
        "spread": "0px",
        "color": "rgba(0, 0, 0, 0.1)"
      }
    },
    "lg": {
      "$type": "shadow",
      "$value": {
        "offsetX": "0px",
        "offsetY": "10px",
        "blur": "30px",
        "spread": "0px",
        "color": "rgba(0, 0, 0, 0.12)"
      }
    }
  },
  "breakpoint": {
    "sm": { "$type": "dimension", "$value": "640px" },
    "md": { "$type": "dimension", "$value": "1024px" },
    "lg": { "$type": "dimension", "$value": "1440px" }
  },
  "duration": {
    "fast": { "$type": "duration", "$value": "150ms" },
    "base": { "$type": "duration", "$value": "300ms" },
    "slow": { "$type": "duration", "$value": "400ms" }
  },
  "easing": {
    "ease-in": { "$type": "cubicBezier", "$value": [0.4, 0, 1, 1] },
    "ease-out": { "$type": "cubicBezier", "$value": [0, 0, 0.2, 1] },
    "ease-in-out": { "$type": "cubicBezier", "$value": [0.4, 0, 0.2, 1] }
  }
}
